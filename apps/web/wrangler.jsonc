{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noaibrowser",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/download/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noaibrowser",
      "database_id": "ef87e110-e4f0-4774-a978-676c09588f11",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "noaibrowser-releases" }],
  // Per-IP limits; they back up the per-voter daily caps enforced in D1.
  "ratelimits": [
    { "name": "LOOKUP_LIMIT", "namespace_id": "4101", "simple": { "limit": 240, "period": 60 } },
    { "name": "FLAG_LIMIT", "namespace_id": "4102", "simple": { "limit": 40, "period": 60 } }
  ],
  // Error logs only: no invocation logs, so no request metadata (like IPs) is retained.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false }, "traces": { "enabled": false } }
}
