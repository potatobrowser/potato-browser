{
  "name": "@potato/browser",
  "productName": "Potato Browser",
  "version": "0.8.0",
  "description": "A Chromium-based browser for the human web. AI features hidden, ads and trackers blocked, no AI in the engine.",
  "author": "Potato Browser",
  "private": true,
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "node scripts/dist.mjs",
    "release-manifest": "node scripts/release-manifest.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@ghostery/adblocker": "2.20.3",
    "@ghostery/adblocker-content": "2.20.3",
    "@ghostery/adblocker-extended-selectors": "2.20.3",
    "@playwright/test": "1.65.0",
    "@potato/shared": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts-experimental": "7.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
