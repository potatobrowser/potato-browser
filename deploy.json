{
  "targets": [
    {
      "name": "web",
      "dir": "apps/web",
      "install": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 pnpm install --frozen-lockfile --filter @potato/web...",
      "run": "pnpm test && pnpm run deploy",
      "paths": [
        "apps/web",
        "packages/shared",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "deploy.json"
      ],
      "url": "https://potatobrowser.com/api/v1/health"
    },
    {
      "name": "public",
      "install": false,
      "run": "scripts/mirror-public.sh",
      "url": "https://github.com/potatobrowser/potato-browser"
    }
  ]
}
